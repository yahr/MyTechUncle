    {
      "id": "cda72020-abd8-472c-8bc0-cdce3be1c257",
      "name": "파일 정보",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const it = $input.first();\nconst b = it.binary.audio;\nconst size = (await this.helpers.getBinaryDataBuffer(0, 'audio')).length;\nconst ext = String((b.fileName || '').includes('.') ? b.fileName.split('.').pop() : b.fileExtension || '').toLowerCase();\nconst mimes = { m4a: 'audio/mp4', mp4: 'audio/mp4', aac: 'audio/aac', mp3: 'audio/mpeg', wav: 'audio/wav', ogg: 'audio/ogg', flac: 'audio/flac', aiff: 'audio/aiff' };\nconst mime = mimes[ext] || (String(b.mimeType).startsWith('audio/') ? b.mimeType : 'audio/mp4');\nreturn [{ json: { size, mime }, binary: it.binary }];"
      }
    },
