        "responseBody": "={{ JSON.stringify({ error: $json.status === \"empty\" ? \"받아쓰기 결과가 비었어요\"\n  : /Payment required|prepayment/i.test(JSON.stringify($json.error || {})) ? \"Gemini 선불 크레딧이 떨어졌어요. AI Studio(ai.studio/projects)에서 충전한 뒤 다시 해 주세요\"\n  : $json.error ? \"받아쓰기 서버 오류: \" + String($json.error.message || $json.error.description || \"\").slice(0, 160)\n  : \"받아쓰기에 실패했어요. 파일 형식(m4a·mp3·wav)을 확인하고 잠시 뒤 다시 보내 주세요\" }) }}",
