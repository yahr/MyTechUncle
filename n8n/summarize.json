      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: \"다음 통화 녹음을 한국어로 그대로 받아써 줘. 화자를 '대표님'/'기술고문'으로 구분할 수 있으면 줄마다 앞에 붙이고, 모르면 붙이지 마. 요약·해석하지 말고 들린 말만. 마크다운 서식(굵은 글씨 등) 없이 일반 텍스트로.\" },\n  { file_data: { mime_type: $json.file.mimeType, file_uri: $json.file.uri } }] }],\n  generationConfig: { temperature: 0, thinkingConfig: { thinkingLevel: \"low\" } } }) }}",
        "options": {
          "timeout": 240000
        }
      },
