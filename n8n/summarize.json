    {
      "id": "40fa56fb-2ef2-4f44-b073-c651bdff4a08",
      "name": "받아쓰기 결과",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const r = $('받아쓰기').first().json;\nconst parts = (r.candidates && r.candidates[0] && r.candidates[0].content && r.candidates[0].content.parts) || [];\nconst transcript = parts.filter(p => p.text && !p.thought).map(p => p.text).join('').trim();\nconst status = transcript ? 'ok' : (r.candidates ? 'empty' : 'fail');\nreturn [{ json: { status, transcript } }];"
      }
    },
