        "jsCode": "const transcript = $('받아쓰기 결과').first().json.transcript;\nif ($json.stop_reason === 'refusal') return [{ json: { refused: true } }];\nconst summary = ($json.content || []).filter(b => b.type === 'text').map(b => b.text).join('').trim();\nif (!summary) throw new Error('요약 결과가 비었어요');\nreturn [{ json: { refused: false, transcript, summary } }];"
